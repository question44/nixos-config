#!/usr/bin/env bash
# master moves only to commits already on origin/master, i.e. squash-merged
# GitHub PRs fetched with `git pull --ff-only`. Commits, merges, resets and
# rebases onto master are refused. Land work with scripts/erebor-land.
# Emergency override: EREBOR_ALLOW_MASTER=1.
[[ $1 == prepared ]] || exit 0
[[ ${EREBOR_ALLOW_MASTER:-} == 1 ]] && exit 0

status=0
while read -r old new ref; do
  [[ $ref == refs/heads/master ]] || continue
  [[ $new =~ ^0+$ || $new == "$old" ]] && continue
  remote=$(git rev-parse -q --verify refs/remotes/origin/master) || continue
  if ! git merge-base --is-ancestor "$new" "$remote" 2>/dev/null; then
    echo "master moves only through GitHub PRs: ${new:0:12} is not on origin/master." >&2
    echo "Land your branch with scripts/erebor-land (parallel-agents skill)." >&2
    status=1
  fi
done
exit $status
