        "tabular_data::MoveFocusedCell",
        {
          "direction": "up"
        }
      ],
      "down": [
        "tabular_data::MoveFocusedCell",
        {
          "direction": "down"
        }
      ],
      "left": [
        "tabular_data::MoveFocusedCell",
        {
          "direction": "left"
        }
      ],
      "right": [
        "tabular_data::MoveFocusedCell",
        {
          "direction": "right"
        }
      ]
    }
  },
  {
    "bindings": {
      "super-{": "pane::ActivatePreviousItem",
