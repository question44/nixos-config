#!/usr/bin/env bash
# Toggle the Noctalia default bar between pinned (always shown, reserving its
# space) and auto-hide (overlaying the workspace, no reserved space).
#
# The mode is written to Noctalia's settings override
# (~/.local/state/noctalia/settings.toml, [bar.default]), which Noctalia
# reloads live and re-applies after config reloads and new logins.  Runtime
# IPC (`bar-auto-hide-set`, `bar-reserve-toggle`) is not used: it is lost on
# every reload of the live config, and the reserve toggle drifted out of step
# with the auto-hide state.
set -euo pipefail

usage() {
  echo "usage: noctalia-bar-autohide [toggle|off|smart|on|status]" >&2
  echo "  off = pinned, smart = smart auto-hide, on = always auto-hide" >&2
  exit 2
}

action="${1:-toggle}"
[[ $# -le 1 ]] || usage
case "$action" in
  toggle|on|off|smart|status) ;;
  *) usage ;;
esac

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/noctalia"
settings="$state_dir/settings.toml"
section="bar.default"

# Current mode from the override; no override means the declarative default
# (pinned).
current="$(awk -v sec="[$section]" '
  /^[[:space:]]*\[/ { in_sec = ($0 == sec); next }
  in_sec && /^smart_auto_hide[[:space:]]*=[[:space:]]*true/ { smart = 1 }
  in_sec && /^auto_hide[[:space:]]*=[[:space:]]*true/ { on = 1 }
  END { print (on ? "on" : (smart ? "smart" : "off")) }
' "$settings" 2>/dev/null || echo off)"

if [[ "$action" == status ]]; then
  printf '%s\n' "$current"
  exit 0
fi
if [[ "$action" == toggle ]]; then
  [[ "$current" == off ]] && action="smart" || action="off"
fi

case "$action" in
  off)   keys=$'auto_hide = false\nsmart_auto_hide = false\nreserve_space = true' ;;
  smart) keys=$'auto_hide = false\nsmart_auto_hide = true\nreserve_space = false' ;;
  on)    keys=$'auto_hide = true\nsmart_auto_hide = false\nreserve_space = false' ;;
esac

mkdir -p "$state_dir"
[[ -e "$settings" ]] || : > "$settings"
tmp="$(mktemp "$settings.XXXXXX")"
trap 'rm -f "$tmp"' EXIT

# Replace the three keys inside [bar.default], keeping every other line;
# add the table if the override does not have it yet.
awk -v sec="[$section]" -v keys="$keys" '
  /^[[:space:]]*\[/ {
    in_sec = ($0 == sec)
    print
    if (in_sec) { print keys; done = 1 }
    next
  }
  in_sec && /^(auto_hide|smart_auto_hide|reserve_space)[[:space:]]*=/ { next }
  { print }
  END { if (!done) printf "\n%s\n%s\n", sec, keys }
' "$settings" > "$tmp"

chmod --reference="$settings" "$tmp"
mv "$tmp" "$settings"
trap - EXIT
printf '%s\n' "$action"
