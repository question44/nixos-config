# Strata's $TERMINAL (wrapped in modules/workstation/packages.nix). Strata
# starts it in the folder to open, or with `-e command args...` to run a
# command. It opens Monstar there and has Umbriel stack the new window below
# the focused one (Strata) in the same column, the way umbriel-monstar-tab
# stacks a tab. A shell opened on a folder follows Strata's folder and
# moves Strata along when it changes directory (home/strata/sync.fish).
app_id="dev.rockorager.monstar"

args=(monstar --working-directory "$PWD")
if [ "${1:-}" = "-e" ]; then
  shift
  args+=(-e "$@")
else
  # A folder: the shell keeps its folder in sync with Strata (sync.fish).
  args+=(-e fish -C "source @syncFish@")
fi

focused="$(umbriel focused-window --json 2>/dev/null || echo '{}')"
anchor_column="$(jq -r '.column // empty' <<<"$focused")"
anchor_floating="$(jq -r '.floating // false' <<<"$focused")"

monstar_ids() {
  umbriel windows --json | jq -r --arg app "$app_id" '.[] | select(.app_id == $app) | .id'
}

before="$(monstar_ids)"
umbriel msg spawn "$(printf '%q ' "${args[@]}")" >/dev/null

# Wait for the new toplevel to map before touching the layout.
new=""
for _ in $(seq 1 100); do
  sleep 0.05
  new="$(comm -13 <(sort <<<"$before") <(monstar_ids | sort) | head -n 1)"
  [ -n "$new" ] && break
done
[ -n "$new" ] || exit 0

# A floating or unknown anchor has no column to stack into.
[ -n "$anchor_column" ] && [ "$anchor_floating" = "false" ] || exit 0

umbriel msg window-focus "$new" >/dev/null
new_column="$(umbriel windows --json | jq -r --arg id "$new" '.[] | select(.id == $id) | .column')"
# New windows open in their own column right of the focused one; anything
# else placed it, so leave it where it is.
if [ "$new_column" = "$((anchor_column + 1))" ]; then
  umbriel msg window-consume-left >/dev/null
fi
