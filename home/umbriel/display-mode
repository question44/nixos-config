# Keep exactly one physical Umbriel output enabled: DP-1 or HDMI-A-1.
# Usage: umbriel-display-mode dp|hdmi|toggle|status
# Virtual outputs (ambilight, sunshine) are never touched.

dp="DP-1"
hdmi="HDMI-A-1"

enabled() {
  umbriel outputs --json | jq -e --arg name "$1" '.[] | select(.name == $name and .enabled)' >/dev/null
}

present() {
  umbriel outputs --json | jq -e --arg name "$1" '.[] | select(.name == $name)' >/dev/null
}

status() {
  local dp_on=false hdmi_on=false
  enabled "$dp" && dp_on=true
  enabled "$hdmi" && hdmi_on=true
  case "$dp_on,$hdmi_on" in
    true,false) echo dp ;;
    false,true) echo hdmi ;;
    true,true) echo both ;;
    *) echo none ;;
  esac
}

# Enable the target before disabling the other, so a physical screen is
# always on; stop if the target is missing or did not come up.
switch_to() {
  local target="$1" other="$2"
  if ! present "$target"; then
    echo "umbriel-display-mode: $target is not connected" >&2
    exit 1
  fi
  umbriel msg output-enable "$target"
  if ! enabled "$target"; then
    echo "umbriel-display-mode: $target did not enable" >&2
    exit 1
  fi
  if present "$other" && enabled "$other"; then
    umbriel msg output-disable "$other"
  fi
}

case "${1:-}" in
  dp) switch_to "$dp" "$hdmi" ;;
  hdmi) switch_to "$hdmi" "$dp" ;;
  toggle)
    if [ "$(status)" = dp ]; then
      switch_to "$hdmi" "$dp"
    else
      switch_to "$dp" "$hdmi"
    fi
    ;;
  status) status ;;
  *)
    echo "usage: umbriel-display-mode dp|hdmi|toggle|status" >&2
    exit 2
    ;;
esac
