#!/usr/bin/env bash
set -euo pipefail

output=ambilight
mode=3440x1440@30

# Umbriel creates virtual outputs at runtime. The compositor has its IPC socket
# by the time autostart commands run; still, make this idempotent for manual
# invocation during a live session.
if ! umbriel outputs --json | jq -e --arg output "$output" \
  '.[] | select(.name == $output)' >/dev/null; then
  umbriel output-create "$output" "$mode"
fi

exec noctalia
