#!/usr/bin/env bash
set -euo pipefail

readonly output="DP-1"
workspaces=""
for _ in {1..40}; do
  if workspaces="$(umbriel workspaces --json 2>/dev/null)" && jq -e 'type == "array"' <<<"$workspaces" >/dev/null; then
    break
  fi
  sleep 0.25
done

[[ -n "$workspaces" ]] || exit 0

workspace_index() {
  jq -r --arg output "$output" \
    '[.[] | select(.output == $output and .name == "background-apps") | .index] | first // empty' \
    <<<"$1"
}

last_index() {
  jq -r --arg output "$output" \
    '[.[] | select(.output == $output) | .index] | max // empty' \
    <<<"$1"
}

named_index="$(workspace_index "$workspaces")"
max_index="$(last_index "$workspaces")"
if [[ -n "$named_index" && -n "$max_index" ]]; then
  umbriel msg "workspace-switch:background-apps/$output"
  for _ in {1..64}; do
    workspaces="$(umbriel workspaces --json 2>/dev/null)" || break
    named_index="$(workspace_index "$workspaces")"
    max_index="$(last_index "$workspaces")"
    [[ -n "$named_index" && -n "$max_index" ]] || break

    # Keep the required empty trailing workspace after background-apps.
    target_index=$((max_index - 1))
    (( named_index < target_index )) || break
    umbriel msg workspace-move-down
  done
fi

# The leading empty workspace is the normal destination for newly launched apps.
umbriel msg "workspace-switch:1/$output"
