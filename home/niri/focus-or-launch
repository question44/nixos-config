#!/usr/bin/env bash
set -euo pipefail

if (( $# < 2 )); then
  echo "usage: niri-focus-or-launch APP_ID[|APP_ID...] COMMAND [ARG...]" >&2
  exit 2
fi

app_ids=$1
shift

lock_key=${app_ids//[^[:alnum:]._-]/_}
lock_file="${XDG_RUNTIME_DIR:-/run/user/$UID}/niri-focus-or-launch-$lock_key.lock"
exec 9>"$lock_file"
flock -n 9 || exit 0

find_window_id() {
  niri msg --json windows | jq -er --arg ids "$app_ids" '
    ($ids | split("|") | map(ascii_downcase)) as $wanted
    | [.[] | select((.app_id // "" | ascii_downcase) as $app | $wanted | index($app))]
    | if length == 0 then empty
      else max_by([.focus_timestamp.secs, .focus_timestamp.nanos]).id
      end
  '
}

focus_window() {
  niri msg action focus-window --id "$1"
  niri msg action center-column
}

if window_id=$(find_window_id); then
  focus_window "$window_id"
  exit 0
fi

"$@" 9>&- >/dev/null 2>&1 &

for _ in {1..40}; do
  sleep 0.05
  if window_id=$(find_window_id); then
    focus_window "$window_id"
    exit 0
  fi
done
