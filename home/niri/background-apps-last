#!/usr/bin/env bash
set -euo pipefail

workspaces=""
for _ in {1..40}; do
  if workspaces="$(niri msg --json workspaces 2>/dev/null)"; then
    break
  fi
  sleep 0.25
done

[[ -n "$workspaces" ]] || exit 0
last_index="$(jq -r '[.[].idx] | max // empty' <<<"$workspaces")"
[[ -n "$last_index" ]] || exit 0

niri msg action move-workspace-to-index "$last_index" --reference background-apps
