#!/usr/bin/env bash
set -euo pipefail

window="$(niri msg --json focused-window)"
app_id="$(jq -r '.Ok.FocusedWindow.app_id // .app_id // empty' <<<"$window")"
pid="$(jq -r '.Ok.FocusedWindow.pid // .pid // empty' <<<"$window")"

case "${app_id,,}" in
  *discord*)
    [[ "$pid" =~ ^[1-9][0-9]*$ ]] || exit 0
    kill -TERM "$pid"
    ;;
  *spotify*)
    busctl --user call org.mpris.MediaPlayer2.spotify \
      /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2 Quit
    ;;
esac
