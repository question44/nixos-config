#!/usr/bin/env bash
set -euo pipefail

app_id="$(niri msg --json focused-window | jq -r '.Ok.FocusedWindow.app_id // .app_id // empty')"

# Do nothing if Niri did not return a focused window; avoid closing anything
# when the IPC response is unavailable or changes shape.
[[ -n "$app_id" ]] || exit 0

case "${app_id,,}" in
  *discord*|*spotify*)
  niri msg action move-window-to-workspace background-apps --focus false
  /home/janzon/.local/bin/niri-background-apps-last
    ;;
  *) niri msg action close-window ;;
esac
