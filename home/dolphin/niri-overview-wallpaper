#!/run/current-system/sw/bin/bash
set -euo pipefail

state_dir="$HOME/.config/niri"
image_link="$state_dir/overview-wallpaper"
unit_file=/etc/systemd/user/niri-overview-wallpaper.service

case "${1:-}" in
  --set)
    image=${2:?Usage: niri-overview-wallpaper --set IMAGE}
    if [[ ! -f "$image" || ! -r "$image" ]]; then
      notify-send "Overview wallpaper" "The selected image is not readable."
      exit 1
    fi
    if ! identify -ping -format '%m' "$image" >/dev/null 2>&1; then
      notify-send "Overview wallpaper" "The selected file is not a supported image."
      exit 1
    fi

    mkdir -p "$state_dir"
    temporary_link="$image_link.tmp.$$"
    ln -sfn -- "$image" "$temporary_link"
    mv -Tf -- "$temporary_link" "$image_link"
    systemctl --user daemon-reload
    systemctl --user restart niri-overview-wallpaper.service
    notify-send "Overview wallpaper" "Updated to $(basename -- "$image")."
    ;;
  --serve)
    image=$(readlink -e -- "$image_link")
    swaybg=$(sed -n 's/^ExecStart=\([^ ]*\).*/\1/p' "$(readlink -f -- "$unit_file")" | head -n 1)
    if [[ -z "$image" || ! -r "$image" || -z "$swaybg" || ! -x "$swaybg" ]]; then
      echo "Could not find the selected image or the current swaybg executable." >&2
      exit 1
    fi
    exec "$swaybg" -o DP-1 -i "$image" -m fill
    ;;
  *)
    echo "Usage: niri-overview-wallpaper --set IMAGE | --serve" >&2
    exit 2
    ;;
esac
