#!/usr/bin/env bash
set -euo pipefail

# xremap runs as a user service; route commands to the active compositor.
case ":${XDG_CURRENT_DESKTOP,,}:" in
  *:umbriel:*)
    exec "$HOME/.local/bin/umbriel-focus-or-launch" "$@"
    ;;
  *)
    echo "Unsupported desktop: ${XDG_CURRENT_DESKTOP:-unset}" >&2
    exit 1
    ;;
esac
