#!/usr/bin/env python3
"""Task board and checks for erebor's tasks/ directory.

  erebor-tasks [list] [--all]    board of open work (--all adds closed tasks)
  erebor-tasks show SYS-NNN      print one task
  erebor-tasks next              next free ID across this tree and every branch
  erebor-tasks new "Title"       create tasks/SYS-NNN.md (then claim it on master)
  erebor-tasks close SYS-NNN DONE|CANCELLED
  erebor-tasks archive           move tasks closed before this month to
                                 tasks/archive/YYYY-MM/ and fix links
  erebor-tasks check [ROOT]      validate IDs, headers, epics and links
  erebor-tasks migrate FILE      convert a legacy SYSTEM_TODO.md into tasks/
                                 (for branches that still edit the old file)

Each task is tasks/SYS-NNN.md (or tasks/archive/YYYY-MM/SYS-NNN.md):

  ---
  status: OPEN            # OPEN, ACTIVE, REVIEW, DONE or CANCELLED
  review: 2026-11-22      # next review date (open statuses)
  closed: 2026-11-08      # closing date (DONE/CANCELLED)
  epic: SYS-087           # optional parent epic
  children: SYS-075, SYS-076   # epics only
  kind: check             # optional: an acceptance check rather than work
  ---

  # SYS-NNN — Title

The ID comes from the file name; the title from the heading.
"""

import datetime
import os
import re
import subprocess
import sys
from pathlib import Path

OPEN = ("ACTIVE", "OPEN", "REVIEW")
CLOSED = ("DONE", "CANCELLED")
FIELDS = ("status", "review", "reviewed", "closed", "epic", "children", "kind")
ID_RE = re.compile(r"^SYS-\d{3,}$")
DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
LINK_RE = re.compile(r"(\]\()([^)\s]+)(\))")
SKIP_DIRS = {".git", "apps", "node_modules", "result"}


def repo_root():
    start = Path.cwd()
    for path in (start, *start.parents):
        if (path / "flake.nix").exists() and (path / "tasks").is_dir():
            return path
    for path in (start, *start.parents):
        if (path / "flake.nix").exists():
            return path
    sys.exit("erebor-tasks: run inside the nixos repository")


class Task:
    def __init__(self, path, root):
        self.path = path
        self.root = root
        self.id = path.stem
        text = path.read_text()
        self.meta, self.body, self.errors = {}, text, []
        if text.startswith("---\n") and "\n---\n" in text[4:]:
            head, self.body = text[4:].split("\n---\n", 1)
            for line in head.splitlines():
                line = line.split("#", 1)[0].rstrip()
                if not line:
                    continue
                key, sep, value = line.partition(":")
                if not sep:
                    self.errors.append(f"bad header line {line!r}")
                    continue
                self.meta[key.strip()] = value.strip()
        else:
            self.errors.append("missing --- header")
        heading = re.search(r"^# (SYS-\d+) — (.+)$", self.body, re.M)
        self.heading_id = heading.group(1) if heading else None
        self.title = heading.group(2) if heading else "(no heading)"

    @property
    def status(self):
        return self.meta.get("status", "")

    @property
    def children(self):
        return [c.strip() for c in self.meta.get("children", "").split(",") if c.strip()]

    def rel(self):
        return self.path.relative_to(self.root)


def load_tasks(root):
    tasks = {}
    dupes = []
    for path in sorted((root / "tasks").rglob("SYS-*.md")):
        task = Task(path, root)
        if task.id in tasks:
            dupes.append(task)
        else:
            tasks[task.id] = task
    return tasks, dupes


def num(task_id):
    return int(task_id.split("-")[1])


# ---------------------------------------------------------------- links


def markdown_files(root):
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS]
        for name in filenames:
            if name.endswith(".md"):
                yield Path(dirpath) / name


def is_relative(target):
    return not re.match(r"^[a-z][a-z0-9+.-]*:", target) and not target.startswith(("#", "/"))


def rewrite_links(root, mapping):
    """Point links at moved files. mapping: old absolute Path -> new absolute Path."""
    changed = []
    for md in markdown_files(root):
        text = md.read_text()

        def fix(match):
            target = match.group(2)
            if not is_relative(target):
                return match.group(0)
            path, sep, anchor = target.partition("#")
            resolved = Path(os.path.normpath(md.parent / path))
            new = mapping.get(resolved)
            if new is None:
                return match.group(0)
            # A moved task file has no inner anchors worth keeping.
            return match.group(1) + os.path.relpath(new, md.parent) + match.group(3)

        new_text = LINK_RE.sub(fix, text)
        if new_text != text:
            md.write_text(new_text)
            changed.append(md)
    return changed


# ---------------------------------------------------------------- commands


def cmd_list(root, args):
    tasks, _ = load_tasks(root)
    today = datetime.date.today().isoformat()
    show_all = "--all" in args
    statuses = OPEN + (CLOSED if show_all else ())
    epics = {t.id: t for t in tasks.values() if t.children}
    for status in statuses:
        group = [t for t in tasks.values() if t.status == status]
        if not group:
            continue
        print(f"\n{status} ({len(group)})")
        for task in sorted(group, key=lambda t: -num(t.id)):
            if task.meta.get("epic") in epics and epics[task.meta["epic"]].status in statuses:
                continue  # listed under its epic
            print_task(task, today)
            for child_id in task.children:
                child = tasks.get(child_id)
                if child and child.status in statuses:
                    print_task(child, today, indent="    └ ")


def print_task(task, today, indent="  "):
    date = task.meta.get("closed") or task.meta.get("review") or task.meta.get("reviewed") or ""
    late = " !overdue" if task.status in OPEN and task.meta.get("review", "9999") < today else ""
    tag = " [epic]" if task.children else (" [check]" if task.meta.get("kind") == "check" else "")
    status = f"{task.status:<9} " if indent != "  " else ""
    print(f"{indent}{task.id}  {status}{task.title}{tag}  {date}{late}")


def cmd_show(root, args):
    tasks, _ = load_tasks(root)
    task = tasks.get(args[0].upper()) if args else None
    if not task:
        sys.exit("usage: erebor-tasks show SYS-NNN")
    print(f"{task.rel()}\n")
    print(task.path.read_text())


def all_known_ids(root):
    ids = set(load_tasks(root)[0])
    try:
        branches = subprocess.run(
            ["git", "-C", str(root), "for-each-ref", "--format=%(refname)", "refs/heads", "refs/remotes"],
            capture_output=True, text=True, check=True,
        ).stdout.split()
    except (OSError, subprocess.CalledProcessError):
        branches = []
    for ref in branches:
        names = subprocess.run(
            ["git", "-C", str(root), "ls-tree", "-r", "--name-only", ref, "tasks"],
            capture_output=True, text=True,
        ).stdout
        ids.update(re.findall(r"(SYS-\d+)\.md", names))
        legacy = subprocess.run(
            ["git", "-C", str(root), "show", f"{ref}:SYSTEM_TODO.md"],
            capture_output=True, text=True,
        ).stdout
        ids.update(re.findall(r"^### (SYS-\d+)", legacy, re.M))
    return ids


def next_id(root):
    ids = all_known_ids(root)
    return f"SYS-{max((num(i) for i in ids), default=0) + 1:03d}"


def cmd_next(root, args):
    print(next_id(root))


def cmd_new(root, args):
    if not args:
        sys.exit('usage: erebor-tasks new "Title"')
    task_id = next_id(root)
    review = (datetime.date.today() + datetime.timedelta(days=14)).isoformat()
    path = root / "tasks" / f"{task_id}.md"
    path.write_text(
        f"---\nstatus: OPEN\nreview: {review}\n---\n\n# {task_id} — {' '.join(args)}\n\n"
        "What is wanted and why (who asked, when).\n\n"
        "Done when: a concrete, observable completion condition.\n"
    )
    print(path.relative_to(root))
    print("Commit this file to master now to claim the ID (see tasks/README.md).")


def set_meta(path, updates, drop=()):
    text = path.read_text()
    head, body = text[4:].split("\n---\n", 1)
    lines = [l for l in head.splitlines() if l.partition(":")[0].strip() not in (*updates, *drop)]
    lines += [f"{k}: {v}" for k, v in updates.items()]
    order = {k: i for i, k in enumerate(FIELDS)}
    lines.sort(key=lambda l: order.get(l.partition(":")[0].strip(), 99))
    path.write_text("---\n" + "\n".join(lines) + "\n---\n" + body)


def cmd_close(root, args):
    if len(args) != 2 or args[1].upper() not in CLOSED:
        sys.exit("usage: erebor-tasks close SYS-NNN DONE|CANCELLED")
    tasks, _ = load_tasks(root)
    task = tasks.get(args[0].upper()) or sys.exit(f"no task {args[0]}")
    set_meta(task.path, {"status": args[1].upper(), "closed": datetime.date.today().isoformat()},
             drop=("review", "reviewed"))
    print(f"{task.rel()}: {args[1].upper()}. Shrink the body to a stub (see tasks/README.md).")


def cmd_archive(root, args):
    tasks, _ = load_tasks(root)
    month = datetime.date.today().strftime("%Y-%m")
    mapping = {}
    for task in tasks.values():
        closed = task.meta.get("closed", "")
        if task.status in CLOSED and task.path.parent == root / "tasks" and closed[:7] < month:
            target = root / "tasks" / "archive" / closed[:7] / task.path.name
            target.parent.mkdir(parents=True, exist_ok=True)
            mapping[task.path] = target
    for old, new in mapping.items():
        text = old.read_text()
        old.unlink()
        new.write_text(text)
    # Links inside moved files are relative to their old place: rebase them.
    for old, new in mapping.items():
        rebase_file_links(new, old.parent, new.parent)
    rewrite_links(root, mapping)
    print(f"Archived {len(mapping)} task(s).")


def rebase_file_links(path, old_dir, new_dir):
    text = path.read_text()

    def fix(match):
        target = match.group(2)
        if not is_relative(target):
            return match.group(0)
        file_part, sep, anchor = target.partition("#")
        resolved = os.path.normpath(old_dir / file_part)
        return match.group(1) + os.path.relpath(resolved, new_dir) + sep + anchor + match.group(3)

    path.write_text(LINK_RE.sub(fix, text))


def cmd_check(root, args):
    if args:
        root = Path(args[0]).resolve()
    tasks, dupes = load_tasks(root)
    errors = []
    for task in dupes:
        errors.append(f"{task.rel()}: duplicate ID {task.id} (also {tasks[task.id].rel()})")
    for task in tasks.values():
        where = task.rel()
        errors += [f"{where}: {e}" for e in task.errors]
        if not ID_RE.match(task.id):
            errors.append(f"{where}: file name is not SYS-NNN.md")
        if task.heading_id != task.id:
            errors.append(f"{where}: heading must be '# {task.id} — Title'")
        for key in task.meta:
            if key not in FIELDS:
                errors.append(f"{where}: unknown header field {key!r}")
        for key in ("review", "reviewed", "closed"):
            if key in task.meta and not DATE_RE.match(task.meta[key]):
                errors.append(f"{where}: {key} must be YYYY-MM-DD")
        status = task.status
        archived = "archive" in task.path.parts
        if status in OPEN:
            if not ("review" in task.meta or "reviewed" in task.meta):
                errors.append(f"{where}: {status} needs a review date")
            if archived:
                errors.append(f"{where}: {status} task in the archive")
        elif status in CLOSED:
            if "closed" not in task.meta:
                errors.append(f"{where}: {status} needs a closed date")
            elif archived and task.path.parent.name != task.meta["closed"][:7]:
                errors.append(f"{where}: archived under the wrong month")
        else:
            errors.append(f"{where}: unknown status {status!r}")
        epic = task.meta.get("epic")
        if epic:
            parent = tasks.get(epic)
            if not parent:
                errors.append(f"{where}: epic {epic} does not exist")
            elif task.id not in parent.children:
                errors.append(f"{where}: epic {epic} does not list it in children")
        for child in task.children:
            if child not in tasks:
                errors.append(f"{where}: child {child} does not exist")
            elif tasks[child].meta.get("epic") != task.id:
                errors.append(f"{where}: child {child} does not name it as epic")
    for md in markdown_files(root):
        in_tasks = (root / "tasks") in md.parents
        for match in LINK_RE.finditer(md.read_text()):
            target = match.group(2)
            if not is_relative(target):
                continue
            file_part = target.partition("#")[0]
            resolved = Path(os.path.normpath(md.parent / file_part))
            if resolved.name == "SYSTEM_TODO.md":
                errors.append(f"{md.relative_to(root)}: link to removed SYSTEM_TODO.md")
            elif (in_tasks or (root / "tasks") in resolved.parents) and not resolved.exists():
                errors.append(f"{md.relative_to(root)}: broken link {target}")
    for error in errors:
        print(error)
    if errors:
        sys.exit(f"erebor-tasks check: {len(errors)} problem(s)")
    print(f"erebor-tasks check: {len(tasks)} tasks OK")


# ---------------------------------------------------------------- migration


def cmd_migrate(root, args):
    """Convert a legacy SYSTEM_TODO.md (default: ./SYSTEM_TODO.md) into tasks/ files.

    Existing task files are overwritten, so run it on a branch, then compare
    with `git diff` and keep only the branch's own changes.
    """
    source = Path(args[0]) if args else root / "SYSTEM_TODO.md"
    text = source.read_text()
    month = datetime.date.today().strftime("%Y-%m")
    sections = re.split(r"^## (.+)$", text, flags=re.M)
    entries = []
    current_section = ""
    for i, chunk in enumerate(sections):
        if i % 2 == 1:
            current_section = chunk.strip()
            continue
        for block in re.split(r"^(?=### SYS-\d+ — )", chunk, flags=re.M):
            if block.startswith("### SYS-"):
                entries.append((current_section, block))
    placed = {}
    parsed = []
    for section, block in entries:
        block = re.sub(r'\n*<a id="sys-\d+"></a>\s*$', "\n", block.rstrip() + "\n")
        heading, _, rest = block.partition("\n")
        task_id, title = re.match(r"### (SYS-\d+) — (.+)", heading).groups()
        rest = rest.lstrip("\n")
        status_para, _, body = rest.partition("\n\n")
        meta = parse_status(status_para)
        if section == "Open checks":
            meta["kind"] = "check"
        closed = meta.get("closed", "")
        if meta.get("status") in CLOSED and closed and closed[:7] < month:
            path = root / "tasks" / "archive" / closed[:7] / f"{task_id}.md"
        else:
            path = root / "tasks" / f"{task_id}.md"
        placed[task_id] = path
        parsed.append((task_id, title, meta, body.strip("\n"), path))
    for task_id, title, meta, body, path in parsed:
        def fix(match, path=path):
            target = match.group(2)
            if target.startswith("#sys-"):
                ref = "SYS-" + target[5:]
                return match.group(1) + os.path.relpath(placed[ref], path.parent) + match.group(3) if ref in placed else match.group(0)
            if not is_relative(target):
                return match.group(0)
            file_part, sep, anchor = target.partition("#")
            resolved = os.path.normpath(source.parent.resolve() / file_part)
            return match.group(1) + os.path.relpath(resolved, path.parent) + sep + anchor + match.group(3)

        body = LINK_RE.sub(fix, body)
        header = "\n".join(f"{k}: {meta[k]}" for k in FIELDS if k in meta)
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(f"---\n{header}\n---\n\n# {task_id} — {title}\n\n{body}\n")
    # Links elsewhere in the repo: SYSTEM_TODO.md#sys-NNN -> the task file.
    legacy = source.resolve()
    for md in markdown_files(root):
        if md.resolve() == legacy or (root / "tasks") in md.parents:
            continue
        original = md.read_text()

        def fix_external(match, md=md):
            target = match.group(2)
            if not is_relative(target):
                return match.group(0)
            file_part, sep, anchor = target.partition("#")
            if Path(os.path.normpath(md.parent / file_part)).name != "SYSTEM_TODO.md":
                return match.group(0)
            ref = "SYS-" + anchor[4:] if anchor.startswith("sys-") else None
            new = placed.get(ref, root / "tasks" / "README.md")
            return match.group(1) + os.path.relpath(new, md.parent) + match.group(3)

        updated = LINK_RE.sub(fix_external, original)
        if updated != original:
            md.write_text(updated)
    print(f"Wrote {len(parsed)} task files.")


def parse_status(paragraph):
    meta = {}
    flat = " ".join(paragraph.split())
    for part in flat.split(" · "):
        match = re.match(r"\*\*(\w+):\*\*\s*(.*)", part.strip())
        if not match:
            continue
        key, value = match.group(1).lower(), match.group(2).strip()
        if key == "status":
            done = re.match(r"(DONE|CANCELLED) \((\d{4}-\d{2}-\d{2})\)", value)
            if done:
                meta["status"], meta["closed"] = done.groups()
            else:
                meta["status"] = value.split()[0]
        elif key in ("review", "reviewed", "closed") and DATE_RE.match(value):
            meta[key] = value
        elif key == "epic":
            meta["epic"] = re.search(r"SYS-\d+", value).group(0)
        elif key == "children":
            meta["children"] = ", ".join(re.findall(r"SYS-\d+", value))
    return meta


def main():
    args = sys.argv[1:]
    command = args.pop(0) if args and not args[0].startswith("-") else "list"
    commands = {
        "list": cmd_list, "show": cmd_show, "next": cmd_next, "new": cmd_new,
        "close": cmd_close, "archive": cmd_archive, "check": cmd_check, "migrate": cmd_migrate,
    }
    if command not in commands:
        sys.exit(__doc__)
    if command == "check" and args:
        root, args = Path(args[0]).resolve(), []  # e.g. the flake check's source copy
    else:
        root = repo_root()
    commands[command](root, args)


if __name__ == "__main__":
    main()
