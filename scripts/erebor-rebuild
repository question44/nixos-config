#!/usr/bin/env bash
# Build or activate erebor, one agent at a time.
#   scripts/erebor-rebuild build|dry-build   any checkout or worktree
#   scripts/erebor-rebuild test              /etc/nixos on master, or an agent/*
#                                            worktree that contains origin/master
#   scripts/erebor-rebuild switch            /etc/nixos on master, equal to
#                                            origin/master (landed through a PR)
# Activating a branch that lacks master would roll back everything else on it.
set -euo pipefail

mode=${1:?usage: erebor-rebuild build|dry-build|test|switch}
repo=$(git rev-parse --show-toplevel)

case $mode in
  build | dry-build) ;;
  test | switch)
    branch=$(git -C "$repo" branch --show-current)
    git -C "$repo" fetch -q origin master 2>/dev/null ||
      echo "Could not fetch origin; checking against the last fetched origin/master." >&2
    remote=$(git -C "$repo" rev-parse origin/master)
    if [[ $repo == /etc/nixos ]]; then
      [[ $branch == master ]] || { echo "/etc/nixos is on $branch, not master." >&2; exit 1; }
      if [[ $mode == switch && $(git -C "$repo" rev-parse HEAD) != "$remote" ]]; then
        echo "master differs from origin/master: land through a PR, then git pull --ff-only." >&2
        exit 1
      fi
    else
      [[ $mode == test ]] || { echo "switch only from /etc/nixos on master; use test here." >&2; exit 1; }
      [[ $branch == agent/* ]] || { echo "Test only agent/* branches (on ${branch:-detached HEAD})." >&2; exit 1; }
      for base in "$remote" master; do
        git -C "$repo" merge-base --is-ancestor "$base" HEAD ||
          { echo "$branch lacks $base; git rebase origin/master first." >&2; exit 1; }
      done
      echo "Testing $branch. Live-linked configs (home/umbriel, home/noctalia, …) still" >&2
      echo "come from /etc/nixos; they change when the PR lands." >&2
    fi
    ;;
  *) echo "Unknown mode: $mode" >&2; exit 1 ;;
esac

# The setuid sudo; an inherited PATH may put the plain store sudo first.
export PATH=/run/wrappers/bin:$PATH

lock=${XDG_RUNTIME_DIR:-/tmp}/erebor-rebuild.lock
exec 9>"$lock"
if ! flock -n 9; then
  echo "Another rebuild holds $lock; waiting..." >&2
  flock 9
fi

if [[ $mode == test || $mode == switch ]]; then
  dirty=$(git -C "$repo" status --short)
  if [[ -n $dirty ]]; then
    echo "Uncommitted changes will be activated too:" >&2
    echo "$dirty" >&2
  fi
  nix flake check "$repo"
  nixos-rebuild "$mode" --sudo --flake "$repo#erebor"
  echo "Active generation: $(readlink /nix/var/nix/profiles/system)"
else
  nixos-rebuild "$mode" --flake "$repo#erebor"
fi
