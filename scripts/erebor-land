#!/usr/bin/env bash
# Land the current agent/* branch on master through a squash-merged GitHub PR.
#   scripts/erebor-land [gh pr create options]   e.g. --title "…" --body-file f
# Run in your worktree once everything is committed: configuration, changelog
# entry and task files. The PR title becomes the squashed commit's subject.
# Without options the PR is filled from the commits (--fill). Afterwards
# /etc/nixos is fast-forwarded to the merge, which puts the live-linked
# configs live; activate with scripts/erebor-rebuild switch if needed.
set -euo pipefail

die() { echo "$*" >&2; exit 1; }
repo=$(git rev-parse --show-toplevel)
[[ $repo != /etc/nixos ]] || die "Run this in your worktree, not /etc/nixos."
branch=$(git branch --show-current)
[[ $branch == agent/* ]] || die "Land agent/* branches only (on ${branch:-detached HEAD})."
[[ -z $(git status --porcelain) ]] || die "Commit or drop your changes first."

git fetch -q origin master
git merge-base --is-ancestor origin/master HEAD ||
  die "$branch is behind origin/master: git rebase origin/master, rebuild, retest."
[[ $(git rev-list --count origin/master..HEAD) -gt 0 ]] || die "Nothing to land."
head=$(git rev-parse HEAD)

git push -q --force-with-lease -u origin "$branch"
if ! pr=$(gh pr view "$branch" --json number,state -q 'select(.state == "OPEN") | .number' 2>/dev/null) ||
  [[ -z $pr ]]; then
  (($#)) || set -- --fill
  gh pr create --base master --head "$branch" "$@" >/dev/null
  pr=$(gh pr view "$branch" --json number -q .number)
fi
gh pr merge "$pr" --squash --match-head-commit "$head"

git -C /etc/nixos fetch -q origin master
if ! git -C /etc/nixos merge -q --ff-only origin/master; then
  die "PR #$pr merged, but /etc/nixos could not fast-forward (uncommitted edits there?).
Ask the user before touching /etc/nixos."
fi
echo "PR #$pr landed; /etc/nixos master is at $(git -C /etc/nixos log --oneline -1)."
echo "Next: activate from /etc/nixos if needed, then"
echo "  git -C /etc/nixos worktree remove --force $repo && git -C /etc/nixos branch -D $branch"
