#!/usr/bin/env bash
# Give one agent task its own branch and checkout of /etc/nixos.
#   scripts/erebor-worktree <task>   creates ~/nixos-wt/<task> on branch agent/<task>
# The branch starts at origin/master (what has landed through PRs).
set -euo pipefail

task=${1:?usage: erebor-worktree <task-name>}
[[ $task =~ ^[a-z0-9][a-z0-9-]*$ ]] || { echo "Use lowercase letters, digits and dashes." >&2; exit 1; }
dir=$HOME/nixos-wt/$task

# The hooks that keep master on origin/master (parallel-agents skill).
git -C /etc/nixos config core.hooksPath .githooks
git -C /etc/nixos fetch -q origin master ||
  echo "Could not fetch origin; starting from the last fetched origin/master." >&2
git -C /etc/nixos worktree add --no-track -b "agent/$task" "$dir" origin/master
# The flake builds the dashboard from its submodule.
git -C "$dir" submodule update --init
echo "$dir"
