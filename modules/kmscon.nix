# kmscon on the text VTs (tty2+; greetd keeps tty1): fontconfig rendering, so
# Nerd Font / Powerline glyphs and truecolor work. The kernel console
# (console.*) still covers boot and the initrd.
#
# Colours follow Noctalia: a Noctalia user template (homeManager half) writes
# the terminal palette to the user's state directory. kmscon runs as root, so
# it never reads that user-writable file: kmscon-palette.service copies only
# lines that are well-formed palette colours into /run/kmscon/kmscon.conf, or
# Dracula when the file is missing or invalid, and restarts the consoles on
# VTs nobody is logged in to. Everything else is a command-line flag, which
# kmscon lets no config file override.
let
  # kmscon palette keys in ANSI order 0-15, then the default colours.
  keys = [
    "black"
    "red"
    "green"
    "yellow"
    "blue"
    "magenta"
    "cyan"
    "light-grey"
    "dark-grey"
    "light-red"
    "light-green"
    "light-yellow"
    "light-blue"
    "light-magenta"
    "light-cyan"
    "white"
    "foreground"
    "background"
  ];
  paletteFile = "kmscon/palette.conf"; # under the user's ~/.local/state
in
{
  flake.modules.nixos.kmscon =
    {
      config,
      lib,
      pkgs,
      ...
    }:
    let
      source = "${config.users.users.${config.my.user.name}.home}/.local/state/${paletteFile}";
      dracula = pkgs.writeText "kmscon-dracula.conf" ''
        palette-black=33,34,44
        palette-red=255,85,85
        palette-green=80,250,123
        palette-yellow=241,250,140
        palette-blue=189,147,249
        palette-magenta=255,121,198
        palette-cyan=139,233,253
        palette-light-grey=248,248,242
        palette-dark-grey=98,114,164
        palette-light-red=255,110,110
        palette-light-green=105,255,148
        palette-light-yellow=255,255,165
        palette-light-blue=214,172,255
        palette-light-magenta=255,146,223
        palette-light-cyan=164,255,255
        palette-white=255,255,255
        palette-foreground=248,248,242
        palette-background=40,42,54
      '';
      applyPalette = pkgs.writeShellApplication {
        name = "kmscon-palette";
        runtimeInputs = with pkgs; [
          coreutils
          diffutils
          gawk
          jq
          systemd
        ];
        text = ''
          src=${lib.escapeShellArg source}
          mkdir -p /run/kmscon
          tmp=$(mktemp /run/kmscon/.kmscon.conf.XXXXXX)
          # Every non-comment line must be palette-<key>=r,g,b (0-255), and
          # every key must be present; anything else means Dracula.
          if [ -f "$src" ] && awk -v keys=${lib.escapeShellArg (lib.concatStringsSep " " keys)} '
            BEGIN { n = split(keys, k, " "); for (i = 1; i <= n; i++) want[k[i]] = 1 }
            /^[[:space:]]*(#|$)/ { next }
            {
              line = $0; gsub(/[[:space:]]/, "", line)
              if (!match(line, /^palette-([a-z-]+)=([0-9]+),([0-9]+),([0-9]+)$/, m)) exit 1
              if (!(m[1] in want) || m[2] > 255 || m[3] > 255 || m[4] > 255) exit 1
              seen[m[1]] = 1; out[m[1]] = line
            }
            END { for (key in want) if (!(key in seen)) exit 1
                  for (i = 1; i <= n; i++) print out[k[i]] }
          ' "$src" > "$tmp.lines"; then
            origin=noctalia
          else
            origin=dracula
            cp ${dracula} "$tmp.lines"
          fi
          { echo "# Generated by kmscon-palette.service ($origin)"; echo "palette=custom"; cat "$tmp.lines"; } > "$tmp"
          rm -f "$tmp.lines"
          chmod 644 "$tmp"
          if cmp -s "$tmp" /run/kmscon/kmscon.conf; then rm -f "$tmp"; exit 0; fi
          mv "$tmp" /run/kmscon/kmscon.conf
          echo "kmscon palette: $origin"
          # Pick up the new colours on consoles no one is logged in to.
          busy=$(loginctl list-sessions --json=short | jq -r '.[].tty // empty')
          for unit in $(systemctl list-units --state=active --plain --no-legend 'kmsconvt@*.service' | awk '{print $1}'); do
            tty=''${unit#kmsconvt@}; tty=''${tty%.service}
            grep -qx "$tty" <<<"$busy" || systemctl restart --no-block "$unit"
          done
        '';
      };
    in
    {
      services.kmscon = {
        enable = true;
        # The module's own config file lives in the store; point kmscon at the
        # generated one (a later --configdir wins) and pass the rest as flags.
        extraOptions = lib.concatStringsSep " " [
          "--configdir=/run/kmscon"
          "--no-libseat"
          "--hwaccel"
          "\"--font-name=JetBrainsMono Nerd Font Mono\""
          "--font-size=16"
          "--xkb-layout=pl"
        ];
      };
      fonts.packages = [ pkgs.nerd-fonts.jetbrains-mono ];

      systemd.services.kmscon-palette = {
        description = "Validate the Noctalia palette for kmscon";
        wantedBy = [ "multi-user.target" ];
        serviceConfig = {
          Type = "oneshot";
          ExecStart = lib.getExe applyPalette;
        };
      };
      systemd.paths.kmscon-palette = {
        wantedBy = [ "multi-user.target" ];
        pathConfig.PathChanged = source;
      };
      systemd.services."kmsconvt@" = {
        after = [ "kmscon-palette.service" ];
        wants = [ "kmscon-palette.service" ];
        # kmscon 10.1 ignores SIGTERM on a VT that was never shown, which held
        # each palette restart for the default 90 s before SIGKILL.
        serviceConfig.TimeoutStopSec = "3s";
      };
    };

  flake.modules.homeManager.kmscon =
    { lib, ... }:
    {
      # Rendered by Noctalia (home/noctalia/config.toml, theme.templates.user.kmscon)
      # from the same terminal colours as its Ghostty theme.
      xdg.configFile."noctalia/templates/kmscon.conf".text =
        let
          terminal = [
            "normal_black"
            "normal_red"
            "normal_green"
            "normal_yellow"
            "normal_blue"
            "normal_magenta"
            "normal_cyan"
            "normal_white"
            "bright_black"
            "bright_red"
            "bright_green"
            "bright_yellow"
            "bright_blue"
            "bright_magenta"
            "bright_cyan"
            "bright_white"
            "foreground"
            "background"
          ];
        in
        lib.concatStrings (
          lib.zipListsWith (
            key: color: "palette-${key}={{colors.terminal_${color}.default.rgb_csv}}\n"
          ) keys terminal
        );
    };
}
