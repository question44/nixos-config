# Generated reference for the per-machine `my.*` options: docs/my-options.md.
# `nix run .#write-docs` rewrites it; checks.my-options (run by
# `nix flake check`) fails when the committed file is stale. The options come
# from the template host, plus the xremap aspect that only some hosts import,
# so defaults are the declared ones rather than erebor's values.
{ config, lib, ... }:
let
  inherit (config.flake.modules) nixos;
  template = config.flake.nixosConfigurations.template.extendModules {
    modules = [ nixos.xremap ];
  };

  # "/nix/store/<hash>-source/modules/my.nix, via option flake.modules.nixos.my"
  # becomes "modules/my.nix"; declarations outside the repo are dropped.
  repoPath =
    decl:
    let
      m = builtins.match "/nix/store/[^/]+-source/([^,]+)(, via option .*)?" (toString decl);
    in
    if m == null then null else builtins.head m;
in
{
  perSystem =
    { pkgs, ... }:
    let
      optionsDoc = pkgs.nixosOptionsDoc {
        options = { inherit (template.options) my; };
        transformOptions =
          opt:
          opt
          // {
            # Links are relative to docs/, where the file lives.
            declarations = map (path: {
              name = path;
              url = "../${path}";
            }) (lib.filter (p: p != null) (map repoPath opt.declarations));
          };
      };

      header = pkgs.writeText "my-options-header.md" ''
        # The `my.*` options

        <!-- Generated by `nix run .#write-docs` from the option declarations; do not edit. -->

        Per-machine settings. Shared modules read `config.my.*` instead of
        hard-coding the user, domain, addresses or devices; a host sets them in
        `modules/hosts/<name>/default.nix`. Defaults are the declared ones, as
        the template host sees them.

      '';

      myOptions = pkgs.runCommand "my-options.md" { } ''
        cat ${header} ${optionsDoc.optionsCommonMark} > $out
      '';
    in
    {
      packages.my-options-doc = myOptions;

      apps.write-docs = {
        type = "app";
        meta.description = "Regenerate docs/my-options.md from the my.* option declarations";
        program = lib.getExe (
          pkgs.writeShellScriptBin "write-docs" ''
            set -eu
            cd "$(${lib.getExe pkgs.git} rev-parse --show-toplevel)"
            install -m 644 ${myOptions} docs/my-options.md
            echo "wrote docs/my-options.md"
          ''
        );
      };

      checks.my-options = pkgs.runCommand "my-options-check" { } ''
        if ! diff -u ${../../docs/my-options.md} ${myOptions}; then
          echo "docs/my-options.md is stale: run \`nix run .#write-docs\` and commit it." >&2
          exit 1
        fi
        touch "$out"
      '';
    };
}
