+#pragma once
+
+#include "capture/screencopy_capture.h"
+#include "core/timer_manager.h"
+
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <optional>
+#include <span>
+#include <string>
+
+class ImageCaptureGlobals;
+class WaylandConnection;
+struct OutputImageCapturePending;
+struct wl_output;
+
+namespace capture {
+  // Converts a 32-bit wl_shm buffer (8888 or 2101010 layouts) to opaque RGBA8; nullopt for other formats.
+  std::optional<std::vector<std::uint8_t>>
+  shmToRgba(std::span<const std::uint8_t> pixels, int width, int height, int stride, std::uint32_t format);
+} // namespace capture
+
+// One full-output frame over ext-image-copy-capture, as raw (untransformed, not y-inverted) RGBA like a
+// wlr-screencopy frame. ScreenshotCapture falls back to it when wlr-screencopy refuses an output: wlroots'
+// screencopy has no shared-memory format for an HDR output's 10-bit or float buffers, while compositors
+// convert ext-image-copy-capture frames.
+class OutputImageCapture {
+public:
+  using CompletionCallback = std::function<void(std::optional<ScreencopyImage>, std::string error)>;
+
+  explicit OutputImageCapture(WaylandConnection& wayland);
+  ~OutputImageCapture();
+
+  bool available() const noexcept;
+  bool busy() const noexcept { return m_pending != nullptr; }
+  void capture(wl_output* output, bool paintCursors, CompletionCallback onComplete);
+  void cancelInFlight();
+
+private:
+  friend struct OutputImageCapturePending;
+  void fail(std::string message);
+  void finish(ScreencopyImage image);
+
+  WaylandConnection& m_wayland;
+  ImageCaptureGlobals& m_imageCapture;
+  std::unique_ptr<OutputImageCapturePending> m_pending;
+  CompletionCallback m_onComplete;
+  Timer m_timeout;
+};
