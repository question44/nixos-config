+#pragma once
+
+// Scene state for the Sequoia wallpaper: loop progress, camera path and yaw
+// noise, time-of-day colours, and the movement ramp used on lock/unlock.
+// Constants are from WallpaperSequoiaExtension (see ../../NOTES.md). No GL.
+
+#include "sequoia_assets.h"
+
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <random>
+
+namespace sequoia {
+
+  enum class Appearance { Automatic, Light, Dark };
+
+  struct SceneSettings {
+    Appearance appearance = Appearance::Automatic;
+    double latitude = 52.23;
+    double longitude = 21.01;
+    int forcedGradient = -1; // 0..7 pins one gradient
+    double speed = 1.0;      // time multiplier (testing)
+  };
+
+  // Critically damped spring, matching SwiftUI.Spring(duration:, bounce: 0) as
+  // used by WallpaperExtensionKit.SpringRamp. Retargeting keeps value and velocity.
+  class SpringRamp {
+  public:
+    void reset(double value) {
+      m_value = value;
+      m_velocity = 0.0;
+      m_target = value;
+    }
+    void retarget(double target, double duration) {
+      m_target = target;
+      m_omega = 2.0 * 3.14159265358979323846 / duration;
+    }
+    void update(double dt);
+    double value() const { return m_value; }
+    double target() const { return m_target; }
+    bool settled(double epsilon) const;
+    void snap() {
+      m_value = m_target;
+      m_velocity = 0.0;
+    }
+
+  private:
+    double m_value = 0.0;
+    double m_velocity = 0.0;
+    double m_target = 0.0;
+    double m_omega = 1.0;
+  };
+
+  // Everything the renderer needs for one frame.
+  struct FrameParams {
+    std::array<float, 16> view{};
+    std::array<float, 16> projection{};
+    float progress = 0.0F;
+    int gradientFrom = 0;
+    int gradientTo = 0;
+    float gradientMix = 0.0F;
+  };
+
+  enum class Movement { Stopped, RampingUp, Moving, RampingDown };
+
+  class Scene {
+  public:
+    using Clock = std::chrono::system_clock;
+
+    Scene(const Assets& assets, std::uint32_t randomSeed);
+
+    void setSettings(const SceneSettings& settings, Clock::time_point now);
+    const SceneSettings& settings() const { return m_settings; }
+
+    // Lock screen: start moving (2 s ease-in). Unlock with still desktop: stop (5 s ease-out).
+    void setMoving(bool moving);
+    // Skips the ramp (startup, tests).
+    void setMovingImmediately(bool moving);
+    Movement movement() const { return m_movement; }
+
+    // Pins the pose (CLI / tests). Negative path or NaN seed keep the current one.
+    void setPose(double progress, int path, double seed);
+    double progress() const { return m_progress; }
+    int path() const { return m_path; }
+    double seed() const { return m_seed; }
+
+    // Advances wall-clock time. Returns true when the next frame differs from the last.
+    bool update(double dt, Clock::time_point now);
+
+    // True while frames must keep coming (moving, ramping or fading colours).
+    bool animating() const;
+
+    // Index of the gradient the clock/appearance currently asks for.
+    int wantedGradient(Clock::time_point now) const;
+
+    FrameParams frame(float aspect) const;
+
+    // Bumped whenever update() changes anything visible; lets callers reuse frames.
+    std::uint64_t generation() const { return m_generation; }
+
+  private:
+    void rerollLoop();
+    double pathX(double t) const;
+    double noise2(double x, double y) const;
+    void checkGradient(Clock::time_point now, bool force);
+
+    const Assets& m_assets;
+    SceneSettings m_settings;
+    std::mt19937 m_rng;
+
+    double m_progress = 0.0;
+    int m_path = 0;
+    double m_seed = 0.0;
+
+    Movement m_movement = Movement::Stopped;
+    SpringRamp m_speed;
+
+    int m_gradientFrom = 0;
+    int m_gradientTo = 0;
+    int m_gradientPending = -1;
+    double m_fadeElapsed = 0.0;
+    bool m_fading = false;
+    double m_sinceGradientCheck = 0.0;
+
+    std::uint64_t m_generation = 1;
+  };
+
+} // namespace sequoia
