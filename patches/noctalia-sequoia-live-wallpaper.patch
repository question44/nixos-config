+namespace {
+
+  struct ResolvedSource {
+    WallpaperSourceKind kind;
+    TextureId texture;
+    float width;
+    float height;
+  };
+
+  // Live sources render the shared Sequoia frame at this node's buffer size and draw it as an image.
+  ResolvedSource resolveSource(
+      WallpaperSourceKind kind, TextureId texture, float width, float height, const CustomDrawContext& context
+  ) {
+    if (kind != WallpaperSourceKind::Live) {
+      return {kind, texture, width, height};
+    }
+    const int bufferWidth = static_cast<int>(std::lround(context.width * context.pixelScaleX));
+    const int bufferHeight = static_cast<int>(std::lround(context.height * context.pixelScaleY));
+    const TextureHandle frame = SequoiaLiveWallpaper::instance().frameTexture(bufferWidth, bufferHeight);
+    return {WallpaperSourceKind::Image, frame.id, static_cast<float>(frame.width), static_cast<float>(frame.height)};
+  }
+
+} // namespace
 
