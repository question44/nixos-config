+void LockSurface::driveLiveFrames() {
+  if (!m_showsLiveWallpaper) {
+    return;
+  }
+  auto& live = SequoiaLiveWallpaper::instance();
+  live.driveFrames(m_animations, this, [this, &live] {
+    live.advance();
+    if (live.takeRepaint(this) && m_wallpaper != nullptr) {
+      m_wallpaper->markPaintDirty();
+    }
+  });
+}
+
 void LockSurface::applyWallpaperTexture() {
   if (usesDesktopCaptureBackground()) {
     applyBlurredDesktopTexture();
     if (m_blurredDesktopTexture.id != 0) {
+      m_showsLiveWallpaper = false;
       return;
     }
   }
 
+  // "sequoia:" draws the shared live scene unblurred, as the macOS lock screen does.
+  m_showsLiveWallpaper = SequoiaLiveWallpaper::isSequoiaPath(m_wallpaperPath);
+  if (m_showsLiveWallpaper) {
+    if (m_wallpaperDirty) {
+      m_wallpaperLease.reset();
+      m_pendingWallpaperLease.reset();
+      m_shownWallpaperPath = m_wallpaperPath;
+      m_pendingWallpaperPath.clear();
+      if (m_blurredWallpaperTexture.id != 0 && renderContext() != nullptr) {
+        renderContext()->backend().makeCurrentNoSurface();
+        renderContext()->textureManager().unload(m_blurredWallpaperTexture);
+        m_blurredWallpaperTexture = {};
+      }
+      m_wallpaper->setSources(
+          WallpaperSourceKind::Live, {}, rgba(0.0F, 0.0F, 0.0F, 1.0F), WallpaperSourceKind::Image, {},
+          rgba(0.0F, 0.0F, 0.0F, 1.0F), 0.0F, 0.0F, 0.0F, 0.0F
+      );
+      m_wallpaper->setTransition(WallpaperTransition::Fade, 0.0F, TransitionParams{});
+      m_wallpaper->setFillMode(m_wallpaperFillMode);
+      m_wallpaper->setFillColor(m_wallpaperFillColor);
+      m_wallpaperDirty = false;
+    }
+    driveLiveFrames();
+    return;
+  }
+
   if (!m_wallpaperDirty) {
     return;
   }
