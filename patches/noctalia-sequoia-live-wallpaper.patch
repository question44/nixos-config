+  SequoiaMotion desktopMotion = SequoiaMotion::Still;
+  SequoiaMotion lockMotion = SequoiaMotion::Animated;
+  std::int32_t fps = 60;        // frame cap while locked
+  std::int32_t desktopFps = 30; // frame cap on the desktop
+  float renderScale = 1.0F;     // fraction of the output resolution rendered
