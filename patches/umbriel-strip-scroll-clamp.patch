diff --git a/src/input/gestures.cpp b/src/input/gestures.cpp
index 142ff36b..a75b459f 100644
--- a/src/input/gestures.cpp
+++ b/src/input/gestures.cpp
@@ -215,6 +215,17 @@ namespace umbriel {
     m_scrollWorkspace = workspace;
     m_viewportPrimary = workspace->scrollViewportExtent();
     m_scrollStart = scrolling->scroll();
+    m_scrollShift = 0;
+    // The strip stops at its first and last snap instead of overscrolling and springing back. A start outside them (a
+    // centered rest) widens the range, so the strip never jumps when the fingers land.
+    m_scrollMin = m_scrollStart;
+    m_scrollMax = m_scrollStart;
+    for (int i = 0; i < static_cast<int>(scrolling->columns().size()); ++i) {
+      for (const double snap : scrolling->snapScrolls(i, m_viewportPrimary)) {
+        m_scrollMin = std::min(m_scrollMin, snap);
+        m_scrollMax = std::max(m_scrollMax, snap);
+      }
+    }
     m_scrollTracker.reset();
     m_scrollStartCentered = scrolling->centeredRest();
     m_scrollScale = scale;
@@ -241,7 +252,11 @@ namespace umbriel {
       return;
     }
     m_scrollTracker.push(delta, timeMsec);
-    scrolling->setScroll(m_scrollStart - m_scrollTracker.pos() * m_scrollScale);
+    // Travel past an end is dropped rather than banked, so reversing moves the strip at once.
+    const double target = m_scrollStart + m_scrollShift - m_scrollTracker.pos() * m_scrollScale;
+    const double clamped = std::clamp(target, m_scrollMin, m_scrollMax);
+    m_scrollShift += clamped - target;
+    scrolling->setScroll(clamped);
     m_scrollWorkspace->markArrange(false);
   }
 
